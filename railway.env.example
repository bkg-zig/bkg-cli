# OneCLI Railway Environment Variables
# Copy to Railway project variables (Settings → Variables)
# Generate secrets with: openssl rand -base64 32 (for base64) or openssl rand -hex 32 (for hex)

# Core secrets (REQUIRED - generate once, use everywhere)
BETTER_AUTH_SECRET=           # base64, 32 bytes: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=        # base64, 32 bytes: openssl rand -base64 32
GATEWAY_INTERNAL_SECRET=      # base64, 32 bytes: openssl rand -base64 32

# Runner / SSH / Channels (REQUIRED)
RUNNER_TOKEN=rnr_             # prefix + hex: rnr_$(openssl rand -hex 32)
RUNNER_SESSION_KEY=k1.        # prefix + hex: k1.$(openssl rand -hex 32)
CHANNEL_ADAPTER_TOKEN=cha_    # prefix + hex: cha_$(openssl rand -hex 32)
SSH_TERMINATOR_SECRET=ssh_    # prefix + hex: ssh_$(openssl rand -hex 32)

# SSH Keys for terminator (REQUIRED)
# Generate: ssh-keygen -t ed25519 -f terminator -N "" -C "onecli-ssh-terminator"
TERMINATOR_HOST_KEY=          # Private key (full PEM including headers)
TERMINATOR_CA_PUBLIC_KEY=     # Public key (single line: ssh-ed25519 AAAA...)

# Domain configuration (REQUIRED)
# Update these to your actual domains
ONECLI_EXTERNAL_URL=https://cli.eysho.info
APP_URL=https://cli.eysho.info
API_URL=https://api.cli.eysho.info
GATEWAY_API_URL=https://gw.cli.eysho.info
ONECLI_TRUSTED_ORIGINS=https://cli.eysho.info
BETTER_AUTH_COOKIE_DOMAIN=cli.eysho.info

# Optional: Slack integration (for Channels)
# SLACK_SHARED_CLIENT_ID=
# SLACK_SHARED_CLIENT_SECRET=
# SLACK_SHARED_SIGNING_SECRET=
# SLACK_SHARED_APP_ID=
# SLACK_SHARED_APP_MANAGER_APPROVED=

# Optional: Email (for auth)
# EMAIL_SERVER_HOST=
# EMAIL_SERVER_PORT=
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM=

# Optional: External database (if not using Railway Postgres)
# DATABASE_URL=postgresql://user:pass@host:5432/db

# Optional: S3-compatible storage (for file uploads)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=