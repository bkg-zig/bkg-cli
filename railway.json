{
  "$schema": "https://railway.com/railway.schema.json",
  "services": {
    "postgres": {
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "healthcheckPath": "/",
        "healthcheckTimeout": 30,
        "restartPolicyType": "ON_FAILURE"
      }
    },
    "migrations": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "docker/migrations.Dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/",
        "restartPolicyType": "ON_FAILURE"
      },
      "dependsOn": ["postgres"],
      "variables": {
        "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
        "ONECLI_VERSION": "${{RAILWAY_TAG}}"
      }
    },
    "api": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "docker/api.Dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/v1/health",
        "healthcheckTimeout": 30,
        "restartPolicyType": "ON_FAILURE",
        "replicas": 1
      },
      "dependsOn": ["migrations"],
      "variables": {
        "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
        "ONECLI_EXTERNAL_URL": "https://cli.eysho.info",
        "APP_URL": "https://cli.eysho.info",
        "API_URL": "https://api.cli.eysho.info",
        "GATEWAY_API_URL": "https://gw.cli.eysho.info",
        "ONECLI_TRUSTED_ORIGINS": "https://cli.eysho.info",
        "BETTER_AUTH_COOKIE_DOMAIN": "cli.eysho.info",
        "ONECLI_VERSION": "${{RAILWAY_TAG}}",
        "BETTER_AUTH_SECRET": "${{BETTER_AUTH_SECRET}}",
        "SECRET_ENCRYPTION_KEY": "${{SECRET_ENCRYPTION_KEY}}",
        "GATEWAY_INTERNAL_SECRET": "${{GATEWAY_INTERNAL_SECRET}}",
        "RUNNER_TOKEN": "${{RUNNER_TOKEN}}",
        "RUNNER_SESSION_KEY": "${{RUNNER_SESSION_KEY}}",
        "CHANNEL_ADAPTER_TOKEN": "${{CHANNEL_ADAPTER_TOKEN}}",
        "SSH_TERMINATOR_SECRET": "${{SSH_TERMINATOR_SECRET}}",
        "TERMINATOR_HOST_KEY": "${{TERMINATOR_HOST_KEY}}",
        "TERMINATOR_CA_PUBLIC_KEY": "${{TERMINATOR_CA_PUBLIC_KEY}}"
      }
    },
    "web": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "docker/web.Dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/",
        "healthcheckTimeout": 60,
        "restartPolicyType": "ON_FAILURE",
        "replicas": 1
      },
      "dependsOn": ["api"],
      "variables": {
        "NEXT_PUBLIC_API_URL": "https://api.cli.eysho.info",
        "NEXT_PUBLIC_GATEWAY_URL": "https://gw.cli.eysho.info",
        "NEXT_PUBLIC_APP_URL": "https://cli.eysho.info",
        "ONECLI_VERSION": "${{RAILWAY_TAG}}"
      }
    },
    "gateway": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "docker/gateway.Dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/health",
        "healthcheckTimeout": 30,
        "restartPolicyType": "ON_FAILURE",
        "replicas": 1
      },
      "dependsOn": ["api"],
      "variables": {
        "GATEWAY_API_URL": "https://gw.cli.eysho.info",
        "API_URL": "https://api.cli.eysho.info",
        "GATEWAY_INTERNAL_SECRET": "${{GATEWAY_INTERNAL_SECRET}}",
        "ONECLI_VERSION": "${{RAILWAY_TAG}}",
        "GATEWAY_ALLOW_PRIVATE_DESTINATIONS": "true"
      }
    },
    "runner": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "docker/runner.Dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/health",
        "healthcheckTimeout": 30,
        "restartPolicyType": "ON_FAILURE",
        "replicas": 1
      },
      "dependsOn": ["api", "gateway"],
      "variables": {
        "RUNNER_TOKEN": "${{RUNNER_TOKEN}}",
        "RUNNER_SESSION_KEY": "${{RUNNER_SESSION_KEY}}",
        "API_URL": "https://api.cli.eysho.info",
        "GATEWAY_API_URL": "https://gw.cli.eysho.info",
        "ONECLI_VERSION": "${{RAILWAY_TAG}}"
      }
    },
    "ssh-terminator": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "docker/ssh-terminator.Dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/health",
        "healthcheckTimeout": 30,
        "restartPolicyType": "ON_FAILURE",
        "replicas": 1
      },
      "dependsOn": ["gateway"],
      "variables": {
        "SSH_TERMINATOR_SECRET": "${{SSH_TERMINATOR_SECRET}}",
        "TERMINATOR_HOST_KEY": "${{TERMINATOR_HOST_KEY}}",
        "TERMINATOR_CA_PUBLIC_KEY": "${{TERMINATOR_CA_PUBLIC_KEY}}",
        "GATEWAY_API_URL": "https://gw.cli.eysho.info",
        "ONECLI_VERSION": "${{RAILWAY_TAG}}"
      }
    },
    "channel-adapter": {
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "docker/channel-adapter.Dockerfile"
      },
      "deploy": {
        "healthcheckPath": "/health",
        "healthcheckTimeout": 30,
        "restartPolicyType": "ON_FAILURE",
        "replicas": 1
      },
      "dependsOn": ["api", "gateway"],
      "variables": {
        "CHANNEL_ADAPTER_TOKEN": "${{CHANNEL_ADAPTER_TOKEN}}",
        "API_URL": "https://api.cli.eysho.info",
        "GATEWAY_API_URL": "https://gw.cli.eysho.info",
        "ONECLI_VERSION": "${{RAILWAY_TAG}}"
      }
    }
  }
}